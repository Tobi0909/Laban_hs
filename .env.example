# Postgres (Neon qua Vercel Marketplace)
DATABASE_URL=

# Auth.js
# AUTH_SECRET: sinh bằng `openssl rand -hex 32`
AUTH_SECRET=
# TEACHER_PASSWORD: mật khẩu đơn giản để đăng nhập trang giáo viên (/teacher/login)
TEACHER_PASSWORD=

# Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (ảnh + MP3)
BLOB_READ_WRITE_TOKEN=

# AI Gateway (chỉ dùng ở trang giáo viên — soạn bài, KHÔNG BAO GIỜ học sinh gọi)
# AI_MODEL: id model qua Vercel AI Gateway, vd "anthropic/claude-sonnet-4-5"
AI_MODEL=anthropic/claude-sonnet-4-5
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# TTS sinh audio tiếng Việt cho bài đã duyệt (trang giáo viên)
# TTS_PROVIDER=mock dùng khi chưa có nhà cung cấp thật (dev/demo)
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_API_URL=

# Dọn dữ liệu quá hạn lưu trữ — Vercel Cron gọi /api/cron/cleanup (xem vercel.json)
# CRON_SECRET: sinh bằng `openssl rand -hex 32`, Vercel tự gửi kèm khi gọi cron
CRON_SECRET=
RETENTION_DAYS=180
